<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    CathodeLib is consumed as a local package rather than a project reference.
    Its .csproj carries a hard <Reference> to
      C:\Program Files (x86)\Reference Assemblies\...\v4.6.2\PresentationCore.dll
    which does not exist on this machine, so building it from source fails.
    The prebuilt 0.12.2 package does not carry that reference, and all of its
    real dependencies (K4os.*, xxHash.NET, System.*) are already in the local
    NuGet cache, so restore works offline.
  -->
  <packageSources>
    <clear />
    <add key="cathodelib-local" value="..\_cathodelib\CathodeLib\bin\Release" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
