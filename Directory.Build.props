<Project>

  <PropertyGroup>
    <!-- Windows-only on purpose: the game is Windows, and targeting
         net9.0-windows gives us Microsoft.Win32.Registry for Steam detection
         without pulling an extra package. -->
    <TargetFramework>net9.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <!-- Off on purpose. Enabling UseWPF stopped the SDK from emitting the implicit
         using directives, which silently removed System.IO from every file. Each
         project declares its own global usings instead, so the set is explicit and
         does not depend on SDK behaviour. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Must stay off. With InvariantGlobalization=true the WPF text stack fails on
         the first TextBlock measure: MS.Internal.FontCache.MajorLanguages needs real
         culture and script/language data, and its type initializer throws without it.
         The window then dies during layout. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Version>0.1.0</Version>
    <Authors>AlienForge</Authors>
  </PropertyGroup>

  <!--
    hkdump.exe is the Havok unpacker HavokDump drives to decode skeletons and
    spline-compressed clips. It looks next to the executable first, so every
    project that can run an export needs its own copy.

    Kept in tools\ inside the repo on purpose. This used to point at
    $(USERPROFILE)\Desktop\_havoklib\build\hkdump_bin\, which meant the build
    silently produced an exporter that could not write bone weights the moment
    that folder went away. A path under the solution cannot go stale like that.

    Missing is still not an error: everything except skeletons and animations
    works without it.
  -->
  <PropertyGroup>
    <HavokDumperPath Condition="'$(HavokDumperPath)' == ''">$(MSBuildThisFileDirectory)tools\hkdump.exe</HavokDumperPath>
  </PropertyGroup>

  <Target Name="CopyHavokDumperToOutput" AfterTargets="Build"
          Condition="'$(OutputType)' == 'Exe' or '$(OutputType)' == 'WinExe'">
    <Warning Condition="!Exists('$(HavokDumperPath)')"
             Text="hkdump.exe not found at $(HavokDumperPath); skeleton and animation export will be unavailable." />
    <Copy Condition="Exists('$(HavokDumperPath)')"
          SourceFiles="$(HavokDumperPath)" DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" ContinueOnError="true" />
  </Target>

  <Target Name="CopyHavokDumperToPublish" AfterTargets="Publish"
          Condition="'$(OutputType)' == 'Exe' or '$(OutputType)' == 'WinExe'">
    <Copy Condition="Exists('$(HavokDumperPath)')"
          SourceFiles="$(HavokDumperPath)" DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" ContinueOnError="true" />
  </Target>

</Project>
